# Copy to ingest/.env and fill in (or export these in your VPS shell / systemd unit).
WORKER_URL="https://cc0-stock.iamdellyson.workers.dev"
INGEST_SECRET="<the production INGEST_SECRET>"

# Direct-R2 upload (recommended, much faster). Leave these blank to fall back to
# base64-through-Worker. Create an R2 API token in the Cloudflare dashboard:
#   R2 > Manage R2 API Tokens > Create API Token > Object Read & Write, bucket cc0-stock.
R2_ACCOUNT_ID="a492d60371140dc0c1860389e31387d1"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cc0-stock"

# Optional: higher Openverse rate limits.
OPENVERSE_CLIENT_ID=""
OPENVERSE_CLIENT_SECRET=""
