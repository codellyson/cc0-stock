{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc0-stock",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "observability": { "enabled": true },
  // Keep the *.workers.dev URL working alongside the custom domains (fallback).
  "workers_dev": true,

  // 8787 is taken on this machine by the justnotetaking worker; use 8799 here.
  "dev": { "port": 8799 },

  // Serve both domains from this one Worker. Requires the kreativekorna.com zone to be
  // active on this Cloudflare account; custom_domain provisions DNS + TLS automatically.
  "routes": [
    { "pattern": "cc0-stock.kreativekorna.com", "custom_domain": true },
    { "pattern": "api.cc0-stock.kreativekorna.com", "custom_domain": true }
  ],

  "vars": {
    // Left blank on purpose: image_url is built from the request's own origin, so the
    // website domain returns website URLs and the API domain returns API URLs. Set a
    // value only to force one absolute origin everywhere.
    "PUBLIC_BASE_URL": ""
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cc0-stock"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc0-stock",
      // Run `wrangler d1 create cc0-stock` and paste the id it prints here.
      "database_id": "a43d3e8b-5360-4261-b064-a7576492885b"
    }
  ],

  // v1 created the MCP Durable Object; v2 removes it — the MCP server is now stateless
  // plain HTTP, so no Durable Object is used at all.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StockMCP"] },
    { "tag": "v2", "deleted_classes": ["StockMCP"] }
  ]
}
